// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  // For reference, github limits size to 39 characters
  username String @unique @db.VarChar(30)

  // Why 234 characters? https://stackoverflow.com/a/1199238
  email String @unique @db.VarChar(234)

  // Why 60 characters? https://security.stackexchange.com/q/39849
  // Nullable: passwordless accounts authenticate via email OTP instead
  password String? @db.VarChar(60)

  features String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([username])
  @@index([email])
  @@index([features], type: Gin)
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique @db.VarChar(96)
  // No FK on purpose, we will experiment a no Foreign Key approach as github does ("At GitHub we do not use foreign keys, ever, anywhere.") https://github.com/github/gh-ost/issues/331#issuecomment-266027731
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model UserActivationToken {
  id         String    @id @default(uuid())
  used_at    DateTime?
  // No FK on purpose, we will experiment a no Foreign Key approach as github does ("At GitHub we do not use foreign keys, ever, anywhere.") https://github.com/github/gh-ost/issues/331#issuecomment-266027731
  user_id    String
  expires_at DateTime
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([user_id])
  @@index([expires_at])
  @@map("user_activation_tokens")
}

model UserOtp {
  id         String    @id @default(uuid())
  used_at    DateTime?
  // No FK on purpose, we will experiment a no Foreign Key approach as github does ("At GitHub we do not use foreign keys, ever, anywhere.") https://github.com/github/gh-ost/issues/331#issuecomment-266027731
  user_id    String
  code_hash  String    @db.VarChar(60)
  expires_at DateTime
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([user_id])
  @@index([expires_at])
  @@map("user_otps")
}

enum GameStatus {
  ACTIVE
  ONLY_DISPLAY
  INACTIVE
  PRIVATE
}

enum GameOwnershipClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SteamImportAttemptOutcome {
  PENDING
  SUCCESS
  NOT_FOUND
  SERVICE_ERROR
  INVALID_DATA
  BLOCKED_ADULT
}

enum GameLocalizationSource {
  STEAM
  FALLBACK
}

enum ReviewScore {
  OVERWHELMINGLY_POSITIVE
  VERY_POSITIVE
  POSITIVE
  MOSTLY_POSITIVE
  MIXED
  MOSTLY_NEGATIVE
  NEGATIVE
  VERY_NEGATIVE
  OVERWHELMINGLY_NEGATIVE
}

model Game {
  id                   String     @id @default(uuid())
  studio_id            String? // Logical reference to Studio.id (Developer); null means unclaimed
  publisher_id         String? // Logical reference to Studio.id (Publisher; absent means self-published by studio_id)
  title                String     @db.VarChar(255)
  slug                 String     @unique @db.VarChar(255)
  description          String     @db.Text
  detailed_description String     @db.Text
  launch_date          DateTime
  status               GameStatus @default(PRIVATE)

  // Financial. Decimal(19,4) is the standard scale for amounts subject to
  // tax: intermediate calculations (commission splits, tax lines, FX) need
  // more precision than the two decimals a currency displays. Rounding
  // happens at the presentation boundary (authorization.filterOutput),
  // never in storage.
  price          Decimal  @db.Decimal(19, 4)
  base_price     Decimal? @db.Decimal(19, 4)
  discount_label String?  @db.VarChar(10)

  // Taxonomy and Authorship
  // developer_name/publisher_name are denormalized from Studio.name at creation time
  // (read-performance tradeoff, same as review_score below) rather than joined live.
  tags           String[] @default([])
  developer_name String   @db.VarChar(255)
  publisher_name String?  @db.VarChar(255)

  // Source Steam app id, set only for games imported via the Steam import
  // flow. Nullable + unique: multiple NULLs are allowed (manual games), but
  // the same Steam app can't be imported twice.
  steam_app_id String? @unique @db.VarChar(20)

  // Informational Steam offer captured during import. These fields are kept
  // separate from price/base_price because they never make the game
  // purchasable on Manifold and may become stale or vary by Steam region.
  steam_price             Decimal?  @db.Decimal(19, 4)
  steam_original_price    Decimal?  @db.Decimal(19, 4)
  steam_discount_percent  Int?
  steam_price_currency    String?   @db.VarChar(3)
  steam_price_captured_at DateTime?

  external_offers GameExternalOffer[]
  localizations   GameLocalization[]

  // Flexibility (JSONB) to facilitate expansion
  meta_tags    Json @default("{}")
  media        Json @default("{}")
  social_links Json @default("{}")
  requirements Json @default("{}")

  // Statistics (Denormalization for storefront read performance)
  positive_reviews Int         @default(0)
  negative_reviews Int         @default(0)
  review_score     ReviewScore @default(MIXED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([studio_id])
  @@index([publisher_id])
  @@index([slug])
  @@index([title])
  @@map("games")
}

model GameOwnershipClaim {
  id                         String                   @id @default(uuid())
  game_id                    String // Logical reference to Game.id
  studio_id                  String // Logical reference to Studio.id
  requested_by_user_id       String // Logical reference to User.id
  status                     GameOwnershipClaimStatus @default(PENDING)
  rights_attestation_text    String                   @db.Text
  rights_attestation_version String                   @db.VarChar(32)
  rights_attestation_locale  String                   @db.VarChar(5)
  rights_attested_at         DateTime
  decided_by_user_id         String? // Logical reference to User.id (admin)
  decided_at                 DateTime?
  decision_reason            String?                  @db.Text
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt

  @@index([game_id, status])
  @@index([studio_id, status])
  @@index([requested_by_user_id])
  @@map("game_ownership_claims")
}

model GameExternalOffer {
  id               String   @id @default(uuid())
  game_id          String
  provider         String   @db.VarChar(20)
  country          String   @db.VarChar(2)
  currency         String   @db.VarChar(3)
  amount           Decimal? @db.Decimal(19, 4)
  original_amount  Decimal? @db.Decimal(19, 4)
  discount_percent Int?
  captured_at      DateTime
  url              String   @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([game_id, provider, country])
  @@index([game_id])
  @@map("game_external_offers")
}

model GameLocalization {
  id                   String                 @id @default(uuid())
  game_id              String
  locale               String                 @db.VarChar(10)
  title                String                 @db.VarChar(255)
  description          String                 @db.Text
  detailed_description String                 @db.Text
  source               GameLocalizationSource
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([game_id, locale])
  @@index([locale, title])
  @@map("game_localizations")
}

// Stateful record used both for abuse prevention and for content-policy audit.
// There are no foreign keys by design; user_id is a logical reference to User.id.
model SteamImportAttempt {
  id                          String                    @id @default(uuid())
  user_id                     String
  steam_app_id                String                    @db.VarChar(20)
  outcome                     SteamImportAttemptOutcome @default(PENDING)
  content_descriptor_ids      Int[]                     @default([])
  content_descriptors_present Boolean                   @default(false)
  created_at                  DateTime                  @default(now())
  updated_at                  DateTime                  @updatedAt

  @@index([user_id, created_at])
  @@index([steam_app_id])
  @@map("steam_import_attempts")
}

model Review {
  id          String   @id @default(uuid())
  user_id     String // Logical reference to User.id
  game_id     String // Logical reference to Game.id
  message     String   @db.Text
  recommended Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([user_id, game_id])
  @@index([user_id])
  @@index([game_id])
  @@map("reviews")
}

model WishlistItem {
  id       String   @id @default(uuid())
  user_id  String // Logical reference to User.id
  game_id  String // Logical reference to Game.id
  added_at DateTime @default(now())

  @@unique([user_id, game_id])
  @@index([user_id])
  @@map("wishlist_items")
}

// A player's durable connection to an Outlet. This is deliberately separate
// from WishlistItem: following a curator and saving a game express different
// intent and will power different product surfaces.
model StoreFollow {
  id       String @id @default(uuid())
  user_id  String // Logical reference to User.id
  store_id String // Logical reference to Store.id

  // No updated_at: a follow is immutable while it exists. Unfollowing and
  // following again creates a new relationship with a new created_at.
  created_at DateTime @default(now())

  @@unique([user_id, store_id])
  @@index([user_id, created_at])
  // Supports future recommendation fan-out without exposing follower data.
  @@index([store_id, created_at])
  @@map("store_follows")
}

enum GamePlatform {
  WINDOWS
  MAC
  LINUX
}

enum GameArchitecture {
  X86_64
  AARCH64
}

enum GameArchiveFormat {
  ZIP
  TAR_GZ
}

enum GameReleaseStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  FAILED
  RETIRED
}

enum GameArtifactStatus {
  PENDING
  VERIFYING
  READY
  FAILED
}

enum GameReleasePatchAlgorithm {
  WHARF
}

enum GameReleasePatchStatus {
  PENDING
  READY
  FAILED
}

model GameFile {
  id           String       @id @default(uuid())
  game_id      String // Logical reference to Game.id
  display_name String       @db.VarChar(255)
  platform     GamePlatform
  file_url     String       @db.VarChar(1024)
  size_bytes   BigInt
  version      String       @db.VarChar(50)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@index([game_id])
  @@map("game_files")
}

// Immutable distribution snapshot. release_number is the machine-facing,
// monotonic identity; version is the human-facing label chosen by the studio.
// References remain logical, consistent with the rest of this schema.
model GameRelease {
  id             String            @id @default(uuid())
  game_id        String // Logical reference to Game.id
  version        String            @db.VarChar(50)
  release_number Int
  status         GameReleaseStatus @default(DRAFT)
  release_notes  String?           @db.Text
  published_at   DateTime?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  @@unique([game_id, release_number])
  @@index([game_id, status, release_number])
  @@map("game_releases")
}

// A release can have one archive for each supported platform/architecture.
// Integrity metadata and the manifest are filled by verification and become
// immutable as soon as the owning release is published.
model GameArtifact {
  id                      String             @id @default(uuid())
  release_id              String // Logical reference to GameRelease.id
  platform                GamePlatform
  architecture            GameArchitecture
  archive_format          GameArchiveFormat
  storage_object_key      String             @unique @db.VarChar(1024)
  created_by_user_id      String? // Logical reference to the publisher User who initiated the upload
  compressed_size_bytes   BigInt?
  installed_size_bytes    BigInt?
  sha256                  String?            @db.Char(64)
  manifest_schema_version String?            @db.VarChar(10)
  manifest                Json?
  status                  GameArtifactStatus @default(PENDING)
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  @@unique([release_id, platform, architecture])
  @@index([release_id, status])
  @@map("game_artifacts")
}

// Immutable incremental path between two compatible release artifacts. All
// references are logical: the model layer validates releases, artifacts and
// the publisher before a row is written or promoted to READY.
model GameReleasePatch {
  id                           String                    @id @default(uuid())
  source_release_id            String // Logical reference to GameRelease.id
  target_release_id            String // Logical reference to GameRelease.id
  target_artifact_id           String // Logical reference to the exact GameArtifact used to generate this patch
  target_artifact_sha256       String                    @db.Char(64)
  platform                     GamePlatform
  architecture                 GameArchitecture
  algorithm                    GameReleasePatchAlgorithm @default(WHARF)
  format_version               String                    @default("1") @db.VarChar(10)
  status                       GameReleasePatchStatus    @default(PENDING)
  patch_storage_object_key     String                    @unique @db.VarChar(1024)
  patch_size_bytes             BigInt
  patch_sha256                 String                    @db.Char(64)
  signature_storage_object_key String                    @unique @db.VarChar(1024)
  signature_size_bytes         BigInt
  signature_sha256             String                    @db.Char(64)
  expected_installation_sha256 String                    @db.Char(64)
  created_by_user_id           String // Logical reference to the publisher User
  generation_duration_ms       BigInt
  created_at                   DateTime                  @default(now())
  updated_at                   DateTime                  @updatedAt

  @@unique([source_release_id, target_release_id, platform, architecture])
  @@index([target_artifact_id, status])
  @@index([target_release_id, status])
  @@index([source_release_id, target_release_id])
  @@map("game_release_patches")
}

enum ItemType {
  GAME
}

model LibraryItem {
  id          String   @id @default(uuid())
  user_id     String // Logical reference to User.id
  item_id     String // Logical reference to the item's id
  item_type   ItemType
  acquired_at DateTime @default(now())

  @@unique([user_id, item_id, item_type])
  @@index([user_id])
  @@map("library_items")
}

// Append-only record of each acquisition event, separate from LibraryItem
// (which is an idempotent entitlement — a no-op on re-acquire). A Sale is
// written on every acquisition, letting the same user acquire the same game
// through multiple stores over time without losing any of those events.
// store_id is nullable: null means the acquisition happened through the
// global storefront (no store attribution), not through a specific store.
model Sale {
  id            String  @id @default(uuid())
  user_id       String // Logical reference to User.id (who acquired)
  game_id       String // Logical reference to Game.id (what was acquired)
  store_id      String? // Logical reference to Store.id; null = platform/global acquisition
  price_at_sale Decimal @db.Decimal(19, 4) // What the buyer was actually charged, in `currency`

  // The currency the buyer was charged in, and the rate that produced the
  // amount when it came from converting the USD base price. Without these a
  // sale records a number with no unit — and the ledger entries written from
  // it could not be reconciled against the rate that was in effect.
  currency      String   @db.VarChar(3) // Logical reference to Currency.code
  exchange_rate Decimal? @db.Decimal(19, 8) // Null when the price was already in this currency

  // No updated_at: sale records are append-only and never modified.
  created_at DateTime @default(now())

  @@index([store_id, created_at])
  @@index([user_id])
  @@index([game_id])
  @@map("sales")
}

model Store {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text
  logo_url    String? @db.VarChar(2048)
  owner_id    String // Logical reference to User.id (creator/owner)

  // What this outlet earns on a sale it referred, as a fraction of the gross.
  // Null means the platform default applies — most outlets never get a bespoke
  // rate, and a null is honest about that where a copied default would look
  // like a decision someone made.
  //
  // Admin-set only. Storefront owners must never influence their own commission
  // for the same reason they cannot set prices (docs/legal/phase-0-checklist.md),
  // which is why this is absent from storeSchema and unreachable through the
  // owner-facing PATCH.
  commission_rate Decimal? @db.Decimal(19, 8)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_id])
  @@index([slug])
  @@map("stores")
}

model StoreMember {
  id          String   @id @default(uuid())
  store_id    String // Logical reference to Store.id
  user_id     String // Logical reference to User.id
  permissions String[] @default([])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([store_id, user_id])
  @@index([store_id])
  @@index([user_id])
  @@map("store_members")
}

model Studio {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?  @db.Text
  logo_url     String?  @db.VarChar(2048)
  is_publisher Boolean  @default(false)
  owner_id     String // Logical reference to User.id (creator/owner)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([owner_id])
  @@index([slug])
  @@map("studios")
}

model StudioMember {
  id          String   @id @default(uuid())
  studio_id   String // Logical reference to Studio.id
  user_id     String // Logical reference to User.id
  permissions String[] @default([])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([studio_id, user_id])
  @@index([studio_id])
  @@index([user_id])
  @@map("studio_members")
}

enum TagFilterMode {
  WHITELIST
  BLACKLIST
}

model StoreTagFilter {
  id         String        @id @default(uuid())
  store_id   String // Logical reference to Store.id
  tag        String        @db.VarChar(100)
  mode       TagFilterMode
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@unique([store_id, tag])
  @@index([store_id])
  @@map("store_tag_filters")
}

enum GameOverrideVisibility {
  SHOW
  HIDE
}

model StoreGameOverride {
  id         String                 @id @default(uuid())
  store_id   String // Logical reference to Store.id
  game_id    String // Logical reference to Game.id
  visibility GameOverrideVisibility
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt

  @@unique([store_id, game_id])
  @@index([store_id])
  @@map("store_game_overrides")
}

model StoreFeaturedGame {
  id                    String   @id @default(uuid())
  store_id              String // Logical reference to Store.id
  game_id               String // Logical reference to Game.id
  position              Int
  recommendation_reason String?  @db.VarChar(240)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([store_id, game_id])
  @@unique([store_id, position])
  @@index([store_id])
  @@index([game_id])
  @@map("store_featured_games")
}

model AdminActionLog {
  id            String   @id @default(uuid())
  admin_user_id String // Logical reference to User.id (who performed the action)
  action        String   @db.VarChar(100)
  target_type   String   @db.VarChar(50)
  target_id     String
  reason        String?  @db.Text
  // Structured extra data an action needs to be reversible, e.g. a
  // { previous_features } snapshot on "user:disable" so "user:enable" can
  // restore exactly what the user had before, rather than a generic default.
  metadata      Json?
  // No updated_at: audit log entries are append-only and never modified.
  created_at    DateTime @default(now())

  @@index([admin_user_id])
  @@index([target_type, target_id])
  @@map("admin_action_logs")
}

// USD is the platform's base currency. Every product carries a USD price and
// prices in other currencies are derived from it (see GamePriceOverride and
// ExchangeRate), so this table is a registry of what we are allowed to price
// and pay in — not a source of prices itself.
model Currency {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(3) // ISO 4217, uppercase (USD, BRL)
  symbol         String   @db.VarChar(8)
  // Presentation scale only. Storage is always Decimal(19,4) regardless, so
  // that intermediate calculations keep more precision than we display.
  decimal_places Int      @default(2)
  enabled        Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([enabled])
  @@map("currencies")
}

enum ExchangeRateSource {
  AUTOMATIC // fetched from an external rate provider
  BULK // loaded in advance, e.g. an agreed fixed monthly set
  MANUAL // written directly by an admin
}

// Append-only: rates are never updated or deleted, so a conversion made months
// ago stays reproducible from the rate that was effective at the time. Reads
// take the newest row whose effective_at is at or before the moment of
// interest.
model ExchangeRate {
  id             String             @id @default(uuid())
  base_currency  String             @db.VarChar(3) // Logical reference to Currency.code
  quote_currency String             @db.VarChar(3) // Logical reference to Currency.code
  rate           Decimal            @db.Decimal(19, 8)
  source         ExchangeRateSource
  effective_at   DateTime
  // No updated_at: rate rows are append-only and never modified.
  created_at     DateTime           @default(now())

  @@index([base_currency, quote_currency, effective_at])
  @@map("exchange_rates")
}

// The chart of accounts. New accounts — tax withholding, a supplier prepaid
// wallet, a processor reserve — are added here as enum values without
// reshaping the table, which is why this is an enum while source_type below,
// whose values must be extensible without a migration at all, is not.
enum LedgerAccountType {
  CONSUMER_PAYMENT // gross collected from a buyer; funds a sale
  SUPPLIER_COST // what the delivered code cost us
  AFFILIATE_COMMISSION // owed to a storefront owner, held until matures_at
  PLATFORM_REVENUE // what is left for the platform
  PAYOUT // a commission balance actually sent to an affiliate
}

// Append-only double-entry ledger. Every money movement is written as a set of
// entries sharing an entry_group_id which sums to zero within each currency,
// so a bug that loses money fails at write time instead of surfacing in a
// payout three weeks later. Nothing here is ever updated: a correction is a
// new, negated entry (see models/ledger.reverse).
//
// Sign convention: positive is money the platform received or holds, negative
// is money it owes or has spent. One sale of 100.00 with a 70.00 supplier cost
// and a 10.00 affiliate commission is therefore:
//
//   CONSUMER_PAYMENT      +100.0000
//   SUPPLIER_COST          -70.0000
//   AFFILIATE_COMMISSION   -10.0000
//   PLATFORM_REVENUE       -20.0000
//                          ---------
//                            0.0000
//
// A commission balance is consequently negative while we owe it. models/ledger
// exposes that flip in one place (payableBalancesFor) so no read path has to
// remember to negate.
model LedgerEntry {
  id String @id @default(uuid())

  // The balanced set this entry was written as part of. Summing to zero is a
  // property of a set rather than of a row, so the set needs its own identity.
  entry_group_id String

  account_type LedgerAccountType

  // Who is owed this, referenced polymorphically the same way source_type and
  // source_id reference what produced it. STORE today: an outlet holds its own
  // balance and its own payout account, so a commission survives the outlet
  // changing hands. STUDIO or USER can be added later without a migration.
  //
  // Both null together for platform accounts, which are owed to nobody. The
  // allowed types live in models/ledger, which is where referential integrity
  // lives in a schema with no foreign keys.
  owner_type String? @db.VarChar(50)
  owner_id   String? // Logical reference to Store.id for STORE

  amount   Decimal @db.Decimal(19, 4)
  currency String  @db.VarChar(3) // Logical reference to Currency.code

  // Set only when this amount was produced by converting from another
  // currency, and then always as a pair: a rate cannot be reconciled later
  // without knowing which pair it applied to.
  exchange_rate               Decimal? @db.Decimal(19, 8)
  exchange_rate_from_currency String?  @db.VarChar(3) // Logical reference to Currency.code

  // Polymorphic reference to whatever produced this entry, the same shape as
  // AdminActionLog.target_type/target_id. Deliberately not an enum: it has to
  // reach a Sale today and an Order later without a migration.
  source_type String @db.VarChar(50)
  source_id   String

  // When a held amount becomes payable; null means no hold. A reversing entry
  // copies the original's value so a clawback cancels it at the same instant.
  // Nulling it would leave the original matured with nothing offsetting it.
  matures_at DateTime?

  // Logical reference to LedgerEntry.id, set on rows written by reverse().
  //
  // Unique, so an entry can be cancelled exactly once. reverse() checks first
  // and reports a clear error, but two chargeback handlers racing would both
  // pass that check and claw the same commission back twice — and with no
  // UPDATE available, a ledger wrong in that direction cannot be repaired.
  // Refunds in this business are all-or-nothing (see
  // docs/legal/business-description.md), so nothing legitimate needs to reverse
  // an entry in parts.
  reverses_entry_id String? @unique

  description String? @db.VarChar(255)

  // No updated_at: ledger entries are append-only and never modified.
  created_at DateTime @default(now())

  @@index([entry_group_id])
  // Leads on the balance query's grouping and carries matures_at as the last
  // column, so the matured filter is served by the same index rather than a
  // separate one on matures_at alone — which nothing would ever choose, since
  // no query filters on maturity without an owner.
  @@index([owner_type, owner_id, account_type, currency, matures_at])
  @@index([source_type, source_id])
  @@map("ledger_entries")
}

// What a supplier keeps from a sale, as a fraction of the gross.
//
// Suppliers come in kinds: a Studio supplies the games in the catalogue today,
// and a gift-card distributor will supply codes later. They share nothing but
// the fact that they take a cut, so this points at one polymorphically
// (supplier_type + supplier_id) exactly as LedgerEntry points at its source.
//
// supplier_type is deliberately not an enum. Onboarding a new kind of supplier
// is a commercial event, not a schema change, and it must not cost a migration.
// The allowed values live in models/commercial_terms, which is where
// referential integrity lives in a schema with no foreign keys.
//
// Unlike ExchangeRate this is mutable rather than append-only. Rates are
// append-only there so a conversion made months ago stays reproducible; that
// reasoning does not carry here, because the ledger already snapshots the
// actual amounts at sale time. A second historical record could only ever
// disagree with the first. AdminActionLog keeps the audit trail.
model SupplierTerms {
  id            String  @id @default(uuid())
  supplier_type String  @db.VarChar(50) // STUDIO, INTEGRATION — see models/commercial_terms
  supplier_id   String // Logical reference to Studio.id, or to a future integration
  cost_rate     Decimal @db.Decimal(19, 8)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([supplier_type, supplier_id])
  @@map("supplier_terms")
}

// Where an outlet's commission is paid.
//
// Hangs off Store rather than User because the outlet is the payee: payment
// details survive a change of ownership, which is the whole point of the
// balance belonging to the outlet rather than to whoever runs it today (see
// docs/ledger-architecture.md).
//
// Deliberately holds no bank details. Those live at the provider, and the only
// thing kept here is an opaque reference to them — which is precisely why this
// table needs an output filter at all.
//
// No tax identifiers or legal addresses yet. docs/legal/phase-0-checklist.md
// says they must exist here encrypted at rest, but the tax posture that decides
// their shape is unsettled, so guessing now would mean migrating a table that
// already holds payout details. payouts_enabled defaulting to false is what
// makes shipping ahead of that answer safe: nothing is payable meanwhile.
model PayoutAccount {
  id       String @id @default(uuid())
  store_id String @unique // Logical reference to Store.id

  // Which rail pays this outlet. A string rather than an enum because
  // onboarding a payout provider is a commercial event, not a schema change —
  // same reasoning as SupplierTerms.supplier_type above. The allowed values
  // live in models/payout_account.
  provider String @db.VarChar(50)

  // The provider's own id for this account. Null until a provider adapter
  // exists to create the account and fill it in.
  //
  // NEVER leaves the server. It is excluded from every filterOutput branch,
  // and it is the single reason a row here cannot simply be returned whole.
  provider_account_id String? @db.VarChar(255)

  // The currency this outlet wants to be paid in. A payout run converts a
  // balance into it, recording the rate as a pair of ledger entries.
  payout_currency String @db.VarChar(3) // Logical reference to Currency.code

  // Free text, for an owner running several outlets to tell their rails apart.
  label String? @db.VarChar(255)

  // False until identity verification passes. Nothing an outlet can reach sets
  // this — the same reasoning that keeps Store.commission_rate out of
  // storeSchema: the party being paid must not be able to declare itself
  // payable. Only the admin backoffice and, later, a provider status sync
  // write it.
  payouts_enabled Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("payout_accounts")
}

// A base-price anchor set explicitly by a developer/admin for one currency. It
// always wins over converting the game's USD base price. The game's global
// promotion ratio is then applied to this anchor, so USD 100 -> 50 and a BRL
// anchor of 200 resolve as BRL 200 -> 100. This is also where commercially-
// shaped regional prices live (e.g. 49.90 rather than a converted 51.37).
//
// Catalog-level only: storefront owners must never gain price control, since
// that is what keeps them affiliates rather than sellers (see
// docs/legal/phase-0-checklist.md). There is deliberately no store_id here.
model GamePriceOverride {
  id         String   @id @default(uuid())
  game_id    String // Logical reference to Game.id
  currency   String   @db.VarChar(3) // Logical reference to Currency.code
  amount     Decimal  @db.Decimal(19, 4)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([game_id, currency])
  @@index([game_id])
  @@index([currency])
  @@map("game_price_overrides")
}
